      "bold": false,
      "text": "a) 通过注册账户提供产品或服务的个人信息控制者，应向个人信息主体提供注销",
      "src": "line",
      "role": "body",
      "heading_candidate": false,
      "heading_score": 0.0
    },
    {
      "y": 604.393310546875,
