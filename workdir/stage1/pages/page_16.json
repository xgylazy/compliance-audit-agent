    },
    {
      "y": 619.8387451171875,
      "size": 11.039999961853027,
      "bold": false,
      "text": "b) 受理注销账户请求后，需要人工处理的，应在承诺时限内（不超过15个工作日）",
      "src": "line",
      "role": "body",
      "heading_candidate": false,
      "heading_score": 0.0
    },
    {
      "y": 635.5933837890625,
