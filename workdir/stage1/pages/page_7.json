      "role": "body",
      "heading_candidate": false,
      "heading_score": 0.0
    },
    {
      "y": 313.3666076660156,
      "size": 11.039999961853027,
      "bold": false,
      "text": "本适用于本文件。凡是不注日期的引用文件，其最新版本（包括所有的修改单）适用于",
      "src": "line",
      "role": "body",
      "heading_candidate": false,
      "heading_score": 0.0
    },
